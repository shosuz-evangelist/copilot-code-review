{
  "name": "Python 3",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/copilot-code-review",
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r requirements.txt",
  "remoteEnv": {
    "MONGODB_URI": "mongodb://mongo:27017/"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "ms-python.python",
        "ms-python.debugpy"
      ]
    }
  }
}
